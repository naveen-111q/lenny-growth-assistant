# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Active LLM Provider: 'ollama' (local, default) or 'openrouter' (cloud)
# REQUIRED
LLM_PROVIDER=ollama

# Ollama Settings (Required when LLM_PROVIDER=ollama)
# Local host URL: http://localhost:11434 (or http://host.docker.internal:11434 if inside Docker container)
OLLAMA_BASE_URL=http://localhost:11434
# Target Ollama model name (e.g. llama3.2, mistral, llama3, qwen2.5)
OLLAMA_MODEL=llama3.2

# OpenRouter Settings (Required when LLM_PROVIDER=openrouter)
# Your OpenRouter API key. Do NOT commit actual keys.
OPENROUTER_API_KEY=
# OpenRouter model ID (e.g. meta-llama/llama-3.3-70b-instruct, anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL
# In Docker Compose: postgresql://postgres:postgres@postgres:5432/lenny_growth
# In local host: postgresql://postgres:postgres@localhost:5432/lenny_growth
# Fallback: SQLite is automatically used for lightweight local test/dev if Postgres is unavailable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth

# ------------------------------------------------------------------------------
# 3. RAG & Embeddings Configuration
# ------------------------------------------------------------------------------
# Embedding model for semantic search (Local HuggingFace model or Ollama)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Similarity search top-K chunks to retrieve
RAG_TOP_K=4
# Minimum cosine similarity threshold (0.0 to 1.0)
RAG_SCORE_THRESHOLD=0.35

# ------------------------------------------------------------------------------
# 4. Network & Service Ports
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501
BACKEND_API_URL=http://localhost:8000
LOG_LEVEL=INFO
